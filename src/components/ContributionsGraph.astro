---
import { GITHUB_TOKEN } from 'astro:env/server';
import { contributions } from '../data/config.js';

// Cache the rendered graph at the CDN for an hour (about 3 GitHub calls per hour regardless of traffic).
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

function nextDOW(targetDOW: number) {
  const date = new Date();
  date.setDate(date.getDate() + ((targetDOW + 7 - date.getDay()) % 7));
  return date;
}
const dims = [20, 7]; // weeks x days
const endDate = nextDOW(6); // Saturday
const adjEnd = new Date(endDate.getTime() - endDate.getTimezoneOffset() * 60000);
const startDate = new Date(new Date().setDate(endDate.getDate() - (dims[0] * dims[1] - 1)));
const adjStart = new Date(startDate.getTime() - startDate.getTimezoneOffset() * 60000);

const query = (username: string) => ({
  query: `
    query {
      user(login: "${username}") {
        contributionsCollection(from: "${adjStart.toISOString()}", to: "${adjEnd.toISOString()}") {
          contributionCalendar { weeks { contributionDays { contributionCount date weekday } } }
        }
      }
    }`
});

type Day = { contributionCount: number; date: string; weekday: number };
let weeks: Day[][] = [];
try {
  if (!GITHUB_TOKEN) throw new Error('GITHUB_TOKEN is not set');
  const responses = await Promise.all(
    contributions.users.map((u) =>
      fetch('https://api.github.com/graphql', {
        method: 'POST',
        body: JSON.stringify(query(u)),
        headers: { Authorization: `bearer ${GITHUB_TOKEN}`, 'User-Agent': 'contributions-graph' }
      }).then((r) => r.json())
    )
  );
  const perUser: Day[][][] = responses.map((r) =>
    r.data.user.contributionsCollection.contributionCalendar.weeks.map((w: { contributionDays: Day[] }) => w.contributionDays)
  );
  const [first, ...others] = perUser;
  weeks = first.map((week, wi) =>
    week.map((day, di) => ({
      ...day,
      contributionCount: others.reduce((acc, o) => acc + o[wi][di].contributionCount, day.contributionCount)
    }))
  );
} catch (e) {
  console.warn('Contributions graph unavailable:', e instanceof Error ? e.message : e);
}

const max = Math.max(0, ...weeks.flat().map((d) => d.contributionCount));
const levels = ['none', 'low', 'med', 'high'];
const level = (count: number) => levels.find((_, i) => count <= (max / (levels.length - 1)) * i) ?? 'none';
---
<div class="contrib place-items-center grid">
  {weeks.map((week, i) => (
    <div class="column" style={`--i:${i}`}>
      {week.map((day) => (
        <div class={`cell ${level(day.contributionCount)}`} title={`${day.contributionCount} Contribution${day.contributionCount == 1 ? '' : 's'}`}></div>
      ))}
    </div>
  ))}
</div>
