---
import { GITHUB_TOKEN } from 'astro:env/server';
import { contributions } from '../data/config.js';

function nextDOW(targetDOW: number) {
  const date = new Date();
  date.setDate(date.getDate() + ((targetDOW + 7 - date.getDay()) % 7));
  return date;
}
const dims = [20, 7]; // weeks x days
const endDate = nextDOW(6); // Saturday
const adjEnd = new Date(endDate.getTime() - endDate.getTimezoneOffset() * 60000);
// The first cell is 139 days before the end Saturday (20 weeks x 7 days = 140 cells, and the end day is one of them).
// 864e5 is one day in milliseconds (24 * 60 * 60 * 1000 = 86,400,000); a Date is a millisecond count, so we subtract
// whole days that way. We count back from endDate itself on purpose: the earlier version took today's date and only
// borrowed endDate's day-of-month (`new Date().setDate(endDate.getDate() - 139)`), which mixed two dates. When the end
// Saturday fell in the next month (e.g. today Nov 30, Saturday Dec 5) the start came out about 30 days too early and
// the grid grew to ~24 columns for the last days of each month.
const startDate = new Date(endDate.getTime() - (dims[0] * dims[1] - 1) * 864e5);
const adjStart = new Date(startDate.getTime() - startDate.getTimezoneOffset() * 60000);

const query = (username: string) => ({
  query: `
    query {
      user(login: "${username}") {
        contributionsCollection(from: "${adjStart.toISOString()}", to: "${adjEnd.toISOString()}") {
          contributionCalendar { weeks { contributionDays { contributionCount date weekday } } }
        }
      }
    }`
});

type Day = { contributionCount: number; date: string; weekday: number };
let weeks: Day[][] = [];
let ok = false;
try {
  if (!GITHUB_TOKEN) throw new Error('GITHUB_TOKEN is not set');
  const responses = await Promise.all(
    contributions.users.map((u) =>
      fetch('https://api.github.com/graphql', {
        method: 'POST',
        body: JSON.stringify(query(u)),
        headers: { Authorization: `bearer ${GITHUB_TOKEN}`, 'User-Agent': 'contributions-graph' }
      }).then((r) => r.json())
    )
  );
  const perUser: Day[][][] = responses.map((r) =>
    r.data.user.contributionsCollection.contributionCalendar.weeks.map((w: { contributionDays: Day[] }) => w.contributionDays)
  );
  const [first, ...others] = perUser;
  weeks = first.map((week, wi) =>
    week.map((day, di) => ({
      ...day,
      contributionCount: others.reduce((acc, o) => acc + o[wi][di].contributionCount, day.contributionCount)
    }))
  );
  ok = true;
} catch (e) {
  console.warn('Contributions graph unavailable:', e instanceof Error ? e.message : e);
}

// Cache the rendered graph at the CDN for an hour (about 3 GitHub calls per hour regardless of traffic). A failed fetch is not
// cached, so one bad moment at GitHub can't leave an empty graph on the CDN.
Astro.response.headers.set('Cache-Control', ok ? 'public, s-maxage=3600, stale-while-revalidate=86400' : 'no-store');

// Quantile tiers: split the active (non-zero) days by rank into 4 equal-sized groups, so one huge day can't squash the rest.
const tiers = ['low', 'med', 'high', 'top'];
const active = weeks.flat().map((d) => d.contributionCount).filter((c) => c > 0).sort((x, y) => x - y);
const cutoffs = tiers.slice(1).map((_, i) => active[Math.ceil((active.length * (i + 1)) / tiers.length) - 1]);
const level = (count: number) => (count <= 0 ? 'none' : tiers[cutoffs.filter((c) => count > c).length]);
---
<div class="contrib place-items-center grid">
  {weeks.map((week, i) => (
    <div class="column" style={`--i:${i}`}>
      {week.map((day) => (
        <div class={`cell ${level(day.contributionCount)}`} data-date={day.date} data-count={day.contributionCount}></div>
      ))}
    </div>
  ))}
</div>
