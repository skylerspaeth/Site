---
const tabs = [
  { href: '/', label: 'Home' },
  { href: '/travel', label: 'Travel' },
  { href: '/photos', label: 'Photos' }
];
---
<nav transition:persist transition:name="tabbar" transition:animate="none" class="fixed inset-x-0 bottom-5 z-50 flex justify-center px-4 sm:top-5 sm:bottom-auto">
  <div id="tabs" class="relative flex items-center gap-1 rounded-pill border border-line bg-surface/80 p-1.5 backdrop-blur-xl">
    <span id="indicator" aria-hidden="true" class="absolute top-1.5 bottom-1.5 left-0 w-0 rounded-pill bg-surface-2 opacity-0 transition-[transform,width,opacity] duration-300 ease-[cubic-bezier(0.32,0.72,0,1)]"></span>
    {tabs.map((t) => (
      <a href={t.href} data-tab class="relative z-10 px-4 py-2 text-sm text-muted transition-colors after:absolute after:-inset-x-0.5 after:-inset-y-1.5 after:content-[''] hover:text-fg aria-[current=page]:text-fg">{t.label}</a>
    ))}
    <button id="theme" type="button" aria-label="Toggle theme"
      class="relative z-10 ml-1 grid size-9 place-items-center text-muted transition-colors after:absolute after:-inset-y-1.5 after:inset-x-0 after:content-[''] hover:text-fg">◐</button>
  </div>
</nav>
<script>
  function sync() {
    const path = location.pathname;
    const ind = document.getElementById('indicator') as HTMLElement | null;
    let hit: HTMLElement | null = null;
    document.querySelectorAll<HTMLAnchorElement>('[data-tab]').forEach((a) => {
      const href = a.getAttribute('href')!;
      const on = href === '/' ? path === '/' : path.startsWith(href);
      a.toggleAttribute('aria-current', on);
      if (on) { a.setAttribute('aria-current', 'page'); hit = a; } else a.removeAttribute('aria-current');
    });
    if (!ind) return;
    if (!hit) { ind.style.opacity = '0'; return; }
    const a = hit as HTMLElement;
    ind.style.width = a.offsetWidth + 'px';
    ind.style.transform = `translateX(${a.offsetLeft}px)`;
    ind.style.opacity = '1';
  }
  // Move the pill as soon as a tab is clicked, so the page-transition's "old" snapshot already shows it in its final spot.
  document.querySelectorAll<HTMLAnchorElement>('[data-tab]').forEach((a) =>
    a.addEventListener('click', () => {
      const ind = document.getElementById('indicator') as HTMLElement | null;
      if (!ind) return;
      ind.style.width = a.offsetWidth + 'px';
      ind.style.transform = `translateX(${a.offsetLeft}px)`;
      ind.style.opacity = '1';
    })
  );
  // Nav persists across page swaps, so only wire the toggle once and re-sync the pill each navigation.
  document.getElementById('theme')?.addEventListener('click', () => {
    const el = document.documentElement;
    const dark = el.dataset.theme ? el.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    el.dataset.theme = dark ? 'light' : 'dark';
    try { localStorage.setItem('theme', el.dataset.theme); } catch {}
  });
  document.addEventListener('astro:page-load', sync);
  addEventListener('resize', sync);
  sync();
</script>
