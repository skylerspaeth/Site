---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import TabBar from '../components/TabBar.astro';
const { title = 'Skyler Spaeth' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <ClientRouter />
    <title>{title}</title>
    <script is:inline>var applyTheme=function(d){try{var t=localStorage.getItem('theme');if(t)(d||document).documentElement.dataset.theme=t}catch(e){}};applyTheme();document.addEventListener('astro:after-swap',function(){applyTheme()});</script>
  </head>
  <body>
    <TabBar />
    <main class="mx-auto max-w-6xl px-5 pt-8 pb-32 sm:pt-28"><slot /></main>
  </body>
</html>
