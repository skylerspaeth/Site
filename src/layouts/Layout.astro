---
import '../styles/global.css';
import TabBar from '../components/TabBar.astro';
// `wide` lets a page use more of the screen (the travel page puts a post list beside the map).
const { title = 'Skyler Spaeth', wide = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <script is:inline>var applyTheme=function(d){try{var t=localStorage.getItem('theme');if(t)(d||document).documentElement.dataset.theme=t}catch(e){}};applyTheme();</script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <TabBar />
    <!-- Keep the top/bottom padding in step with --page-fit in global.css. -->
    <main class:list={['mx-auto w-full flex-1 px-5 pt-28 pb-6', wide ? 'max-w-[100rem]' : 'max-w-6xl']}><slot /></main>
  </body>
</html>
