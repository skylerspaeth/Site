---
import { getCollection, render } from 'astro:content';
import CountryChips from '../../components/CountryChips.astro';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  return (await getCollection('posts')).map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const when = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(post.data.date);
---
<Layout title={post.data.title}>
  <article class="mx-auto max-w-2xl">
    <a href="/travel" class="text-sm text-muted hover:text-fg">← All posts</a>
    <p class="mt-4 text-sm text-muted">{when}</p>
    <h1 class="mt-1 text-3xl font-semibold">{post.data.title}</h1>
    <div class="mt-3"><CountryChips codes={post.data.countries} link /></div>
    <div class="prose mt-6 max-w-none prose-img:rounded-2xl [--tw-prose-body:var(--text)] [--tw-prose-headings:var(--text)] [--tw-prose-links:var(--accent)] [--tw-prose-bold:var(--text)] [--tw-prose-quotes:var(--text)] [--tw-prose-bullets:var(--muted)] [--tw-prose-counters:var(--muted)] [--tw-prose-hr:var(--border)] [--tw-prose-code:var(--text)] [--tw-prose-captions:var(--muted)]"><Content /></div>
  </article>
</Layout>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  // Clicking a photo in a post opens it fullscreen; all the post's photos form one gallery (arrows, Esc, swipe).
  const lightbox = new PhotoSwipeLightbox({ gallery: '.prose', children: 'img', pswpModule: () => import('photoswipe'), zoom: false, // hides the zoom button only; clicking the photo still zooms
    // Leave a strip under the photo for its caption (only when it has one), so the caption never covers the image.
    paddingFn: (_viewport, item) => ({ top: 0, bottom: item.alt ? 56 : 0, left: 0, right: 0 }) });
  lightbox.addFilter('itemData', (item) => {
    const img = item.element as HTMLImageElement;
    return { ...item, src: img.currentSrc || img.src, w: Number(img.getAttribute('width')), h: Number(img.getAttribute('height')), alt: img.alt };
  });
  // The image's alt text doubles as its caption, shown under the photo in the viewer and as a hover tooltip.
  document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => { img.title = img.alt; });
  lightbox.on('uiRegister', () => {
    lightbox.pswp!.ui!.registerElement({
      name: 'caption', order: 9, isButton: false, appendTo: 'root', html: '',
      onInit: (el, pswp) => pswp.on('change', () => { el.textContent = pswp.currSlide?.data.alt ?? ''; }),
    });
  });
  lightbox.init();
</script>

<script>
  // Heading link buttons copy the section's full URL without navigating or changing the address bar.
  document.addEventListener('click', async (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a.anchor');
    if (!a) return;
    e.preventDefault();
    const url = new URL(a.getAttribute('href')!, location.href).href;
    try { await navigator.clipboard.writeText(url); } catch {}
    a.classList.add('copied');
    setTimeout(() => a.classList.remove('copied'), 1500);
  });
</script>
