---
import Layout from '../layouts/Layout.astro';
const posts = [
  { title: 'Sapporo in winter', place: 'Japan', hue: 220 },
  { title: 'Night trains', place: 'Taiwan', hue: 280 },
  { title: 'Rainforest mornings', place: 'USA', hue: 150 }
];
---
<Layout title="Travel">
  <h1 class="mb-6 text-3xl font-semibold tracking-tight">Travel</h1>
  <div class="mb-6 grid aspect-[16/9] place-items-center rounded-card border border-line bg-surface text-muted">Globe goes here</div>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((p) => (
      <a href="#" class="group overflow-hidden rounded-card border border-line bg-surface transition-colors hover:bg-surface-2">
        <div class="aspect-[4/3]" style={`background: linear-gradient(135deg, hsl(${p.hue} 70% 45%), hsl(${p.hue + 60} 60% 20%))`}></div>
        <div class="p-5"><p class="text-xs text-muted">{p.place}</p><h2 class="mt-1 font-medium">{p.title}</h2></div>
      </a>
    ))}
  </div>
</Layout>
