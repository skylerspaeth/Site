---
import { getCollection } from 'astro:content';
import countries from 'world-countries';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import TravelMap from '../components/TravelMap.astro';
import { loadVisits } from '../lib/visited-sheet';

// Newest first.
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// Distinct countries from the sheet, out of the 195 recognized countries (193 UN members + 2 observers).
const TOTAL = 195;
const visitedCount = new Set((await loadVisits()).map((v) => v.code)).size;
const percent = (visitedCount / TOTAL) * 100;
const where = (codes: string[]) =>
  codes.map((code) => countries.find((c) => c.cca2 === code)).filter((c) => c !== undefined).map((c) => `${c.flag} ${c.name.common}`);
const when = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Layout title="Travel" wide>
  <!-- Max width = list (26rem) + gap (1rem) + the map at its largest, so the pair stays centered on wide screens. -->
  <div class="mx-auto grid max-w-[calc(27rem_+_var(--page-fit)_*_3_/_2)] gap-4 lg:grid-cols-[26rem_1fr]">
    <!-- On small screens the map comes first and the list follows; from lg up the list sits on the left. -->
    <nav aria-label="Travel posts" class="order-2 flex flex-col gap-2 lg:order-1 lg:h-[var(--page-fit)] lg:overflow-y-auto">
      <div class="rounded-2xl border border-line bg-surface px-4 py-3">
        <div class="flex items-baseline justify-between gap-3 text-sm">
          <span><span class="text-lg font-medium">{visitedCount}</span> <span class="text-muted">of {TOTAL} countries visited</span></span>
          <span class="font-medium">{percent.toFixed(1)}%</span>
        </div>
        <div role="progressbar" aria-label="Countries visited" aria-valuemin="0" aria-valuemax={TOTAL} aria-valuenow={visitedCount} class="mt-2 h-2 overflow-hidden rounded-full bg-surface-2">
          <div class="h-full rounded-full bg-accent" style={`width: ${percent}%`}></div>
        </div>
      </div>
      <!-- Shown while a country is selected on the map (see the script below and TravelMap.astro). -->
      <div id="country-filter" hidden class="flex items-center justify-between gap-3 rounded-2xl border border-line bg-surface px-4 py-2 text-sm">
        <span id="country-filter-label"></span>
        <button type="button" id="country-filter-clear" class="text-muted underline underline-offset-2 hover:text-fg">Show all</button>
      </div>
      <p id="country-filter-empty" hidden class="px-1 text-sm text-muted">No posts from here yet.</p>
      {posts.map((post, i) => (
        <a href={`/travel/${post.id}`} data-countries={post.data.countries.join(' ')} class="flex items-center gap-4 rounded-2xl border border-line bg-surface p-3 transition-colors hover:bg-surface-2">
          {post.data.photo ? (
            <Image src={post.data.photo} alt="" width={160} height={160} class="aspect-square size-16 shrink-0 rounded-xl object-cover" />
          ) : (
            // No photo yet: a placeholder gradient, like the photo portfolio's.
            <div class="aspect-square size-16 shrink-0 rounded-xl" style={`background: linear-gradient(135deg, hsl(${(i * 70 + 220) % 360} 70% 45%), hsl(${(i * 70 + 280) % 360} 60% 20%))`}></div>
          )}
          <div class="min-w-0">
            <p class="text-xs text-muted">
              {when.format(post.data.date)}<span class="mx-[3px] font-bold">·</span>{where(post.data.countries).map((place, n) => <Fragment>{n > 0 && ', '}<span class="whitespace-nowrap">{place}</span></Fragment>)}
            </p>
            <h2 class="mt-1 font-medium">{post.data.title}</h2>
          </div>
        </a>
      ))}
    </nav>
    <div class="order-1 lg:order-2"><TravelMap /></div>
  </div>
</Layout>

<script>
  // The map announces the selected country (or null) when a visited country is clicked; show only its posts.
  const posts = [...document.querySelectorAll<HTMLElement>('[data-countries]')];
  const bar = document.getElementById('country-filter')!;
  const empty = document.getElementById('country-filter-empty')!;
  window.addEventListener('travel:country', (e) => {
    const country = (e as CustomEvent<{ code: string; name: string; flag: string } | null>).detail;
    let shown = 0;
    for (const post of posts) {
      const match = !country || post.dataset.countries!.split(' ').includes(country.code);
      post.hidden = !match;
      if (match) shown++;
    }
    bar.hidden = !country;
    empty.hidden = !country || shown > 0;
    if (country) document.getElementById('country-filter-label')!.textContent = `Showing posts from ${country.flag} ${country.name}`;
  });
  document.getElementById('country-filter-clear')!.addEventListener('click', () => window.dispatchEvent(new CustomEvent('travel:clear')));
</script>
