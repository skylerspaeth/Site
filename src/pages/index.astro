---
import Layout from '../layouts/Layout.astro';
import ContributionsGraph from '../components/ContributionsGraph.astro';
import '../styles/contributions.css';
---
<Layout>
  <section class="flex min-h-[60dvh] flex-col items-center justify-center gap-6 text-center">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-6xl">Hi there <span aria-hidden="true">👋</span></h1>
    <p class="max-w-md text-muted">Placeholder intro. Travel notes and photography.</p>
  </section>
  <section class="flex justify-center">
    <ContributionsGraph server:defer>
      <!-- Empty grid placeholder (same 20x7 layout); the real cells replace it all at once. -->
      <div slot="fallback" class="contrib place-items-center grid">
        {Array.from({ length: 20 }, () => (
          <div class="column">
            {Array.from({ length: 7 }, () => <div class="cell none"></div>)}
          </div>
        ))}
      </div>
    </ContributionsGraph>
  </section>
</Layout>
