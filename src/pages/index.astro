---
import Layout from '../layouts/Layout.astro';
import ContributionsGraph from '../components/ContributionsGraph.astro';
import '../styles/contributions.css';
---
<Layout>
  <section class="flex flex-col items-center justify-center gap-6 pb-10 pt-[12dvh] text-center">
    <h1 class="text-2xl font-semibold tracking-tight sm:text-4xl">Hi there <span aria-hidden="true">👋</span></h1>
    <p class="max-w-[24.75em] text-muted">I’m <span class="font-medium text-fg/80">Skyler</span>, a systems engineer based in Austin, Texas, who loves aviation, photography, and travel.</p>
  </section>
  <section class="flex justify-center">
    <ContributionsGraph server:defer>
      <!-- Empty grid placeholder (same 20x7 layout); the real cells replace it all at once. -->
      <div slot="fallback" class="contrib place-items-center grid">
        {Array.from({ length: 20 }, () => (
          <div class="column">
            {Array.from({ length: 7 }, () => <div class="cell none"></div>)}
          </div>
        ))}
      </div>
    </ContributionsGraph>
  </section>
</Layout>
