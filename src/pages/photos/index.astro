---
import Layout from '../../layouts/Layout.astro';
import { series, placeholder } from '../../data/photos.js';
---
<Layout title="Photos">
  <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
    {series.map((s, i) => (
      <a href={`/photos/${s.slug}`} class="group relative block aspect-[4/5] overflow-hidden rounded-2xl" style={placeholder(i, 0)}>
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent transition-opacity group-hover:opacity-80"></div>
        <div class="absolute inset-x-0 bottom-0 p-4">
          <h2 class="text-lg font-semibold text-white">{s.title}</h2>
          <p class="text-sm text-white/70">{s.ratios.length} photos</p>
        </div>
      </a>
    ))}
  </div>
</Layout>
