---
import Layout from '../layouts/Layout.astro';
const series = ['All', 'Nocturnes', 'Snow', 'Monochrome'];
const ratios = ['3/4', '1/1', '4/3', '2/3', '16/9', '4/5', '3/2', '1/1', '2/3'];
---
<Layout title="Photos">
  <h1 class="mb-6 text-3xl font-semibold tracking-tight">Photos</h1>
  <div class="mb-6 flex flex-wrap gap-2">
    {series.map((s, i) => (
      <span class:list={['rounded-pill border border-line px-4 py-1.5 text-sm', i === 0 ? 'bg-surface-2 text-fg' : 'text-muted']}>{s}</span>
    ))}
  </div>
  <div class="columns-2 gap-3 sm:columns-3">
    {ratios.map((r, i) => (
      <div class="mb-3 break-inside-avoid rounded-2xl" style={`aspect-ratio:${r}; background: linear-gradient(${i * 40}deg, hsl(${(i * 47) % 360} 65% 50%), hsl(${(i * 47 + 50) % 360} 55% 18%))`}></div>
    ))}
  </div>
</Layout>
